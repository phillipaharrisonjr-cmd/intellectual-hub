{
  "name": "denali-backend",
  "version": "1.1.0",
  "description": "Denali backend: ACH intelligence, revenue projections, referrals, and the Denali assistant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:replay": "vitest run test/projection.replay.test.js",
    "lint": "eslint .",
    "prepare": "cd .. && husky backend/.husky 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
